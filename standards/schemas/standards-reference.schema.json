{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XO-Code Busters standards references",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "standards"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "standards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "path",
          "version",
          "commit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^standards/.+\\.md$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        }
      }
    }
  }
}
