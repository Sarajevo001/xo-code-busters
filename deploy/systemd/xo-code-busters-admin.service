# DRAFT ONLY: do not enable until administrator authentication is complete and deployment is approved.
[Unit]
Description=XO-Code Busters Administrator API (restricted scaffold)
After=network.target

[Service]
Type=simple
User=xo-code-busters
WorkingDirectory=/srv/xo-code-busters/src/admin-server
Environment=NODE_ENV=production
Environment=ADMIN_HOST=127.0.0.1
Environment=ADMIN_PORT=3001
ExecStart=/usr/bin/node /srv/xo-code-busters/src/admin-server/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
