{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XO-Code Busters project URL assignments v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "host",
          "path"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^(?!\\.{1,2}/)[A-Za-z0-9_.-]+/(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
          },
          "host": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
          },
          "path": {
            "type": "string",
            "pattern": "^/(?:[A-Za-z0-9_.~-]+/)*$"
          }
        }
      }
    }
  }
}
